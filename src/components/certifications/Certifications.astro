---
import { Image } from "astro:assets";
import { certificationsData } from "./data/certificationsData";
import ProjectButton from "@/components/projects/components/ProjectButton.astro";
import OpenLinkIcon from "@/components/icons/OpenLinkIcon.astro";
import CertificateIcon from "@/components/icons/CertificateIcon.astro";
import CalendarIcon from "@/components/icons/CalendarIcon.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

interface Props {
  id: string;
}

const { id } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section
  id={id}
  class="py-5 flex flex-col items-center justify-start gap-10 text-white px-4 sm:px-8"
>
  <div class="flex flex-col">
    <h2
      class="font-bold text-center z-100 section-title"
      data-aos="fade-up"
      data-aos-duration="800"
    >
      {t("certifications.title")}
    </h2>
    <p
      class="mt-3 text-center max-w-4xl z-100 section-description"
      data-aos="fade-up"
      data-aos-duration="900"
      set:html={t("certifications.description")}
    />
  </div>

  <ul
    class="grid lg:grid-cols-2 gap-5 w-full max-w-6xl"
    data-aos="fade-up"
    data-aos-duration="1000"
  >
    {
      certificationsData.map(
        ({ title, issuer, date, detail, image, landscape, documentUrl, verifyUrl, verifyCode }) => (
          <li class="group flex flex-col sm:flex-row rounded-3xl overflow-hidden bg-white/10 hover:animate-lift">
            <a
              href={documentUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="relative sm:w-44 shrink-0 aspect-[4/3] sm:aspect-auto overflow-hidden bg-white"
              aria-label={`${t("certifications.button.view")}: ${t(title)}`}
            >
              <Image
                src={image}
                alt={t(title) as string}
                width={360}
                class={`absolute inset-0 h-full w-full transition-transform duration-300 group-hover:scale-105 ${landscape ? "object-cover object-[50%_40%] scale-[1.35] group-hover:scale-[1.42]" : "object-cover object-top"}`}
              />
            </a>
            <div class="flex flex-col gap-2 p-5 sm:p-6 flex-1">
              <p class="flex items-center gap-2 text-sm font-semibold text-accent">
                <CertificateIcon class="size-5" />
                {t(issuer)}
              </p>
              <h3 class="text-lg xl:text-xl font-semibold leading-snug">
                {t(title)}
              </h3>
              <p class="flex items-center gap-1 text-sm text-gray-300">
                <CalendarIcon class="size-4 text-accent" />
                {t(date)}
              </p>
              <p class="text-sm text-neutral-300">{t(detail)}</p>
              {verifyCode && (
                <p class="text-xs text-gray-400">
                  {t("certifications.code")}:{" "}
                  <span class="font-mono text-white/90">{verifyCode}</span>
                </p>
              )}
              <div class="flex gap-3 mt-auto pt-3">
                <div class="flex-1">
                  <ProjectButton href={documentUrl} primary>
                    {t("certifications.button.view")}
                    <OpenLinkIcon class="size-4" />
                  </ProjectButton>
                </div>
                {verifyUrl && (
                  <div class="flex-1">
                    <ProjectButton href={verifyUrl}>
                      {t("certifications.button.verify")}
                    </ProjectButton>
                  </div>
                )}
              </div>
            </div>
          </li>
        )
      )
    }
  </ul>
</section>
