---
import { Image } from "astro:assets";
import type { ProjectStatus } from "@/types/Project";
import type { TranslationKey } from "@/i18n/types";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

interface Props {
  alt: string;
  color: string;
  emoji: string;
  status: ProjectStatus;
  image?: ImageMetadata;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { alt, color, emoji, status, image } = Astro.props;

const statusClasses: Record<ProjectStatus, string> = {
  production: "bg-emerald-500/90 text-white",
  completed: "bg-slate-600/90 text-white",
  development: "bg-amber-500/90 text-slate-950",
};
const statusKey = `projects.status.${status}` as TranslationKey;
---

<div class="relative rounded-t-xl shadow-md aspect-video overflow-hidden">
  {
    image ? (
      <Image
        src={image}
        alt={alt}
        class="absolute inset-0 h-full w-full object-cover object-left-top transition-transform duration-300 ease-out group-hover:scale-105"
        width={640}
      />
    ) : (
      <div
        class="absolute inset-0 flex items-center justify-center transition-transform duration-300 ease-out group-hover:scale-105"
        style={{
          backgroundImage: `radial-gradient(circle at 30% 20%, ${color}66, transparent 60%), linear-gradient(135deg, ${color}40, #0b1120 85%)`,
        }}
        role="img"
        aria-label={alt}
      >
        <span
          class="absolute inset-0 opacity-20"
          style={{
            backgroundImage: `linear-gradient(${color}55 1px, transparent 1px), linear-gradient(90deg, ${color}55 1px, transparent 1px)`,
            backgroundSize: "28px 28px",
          }}
        />
        <span
          class="relative flex size-20 items-center justify-center rounded-3xl border border-white/20 bg-white/10 text-4xl shadow-xl backdrop-blur-sm"
          aria-hidden="true"
        >
          {emoji}
        </span>
      </div>
    )
  }
  <span
    class={`absolute top-3 left-3 rounded-full px-3 py-0.5 text-xs font-semibold shadow ${statusClasses[status]}`}
  >
    {t(statusKey)}
  </span>
</div>
