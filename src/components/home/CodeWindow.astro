---
import { getLangFromUrl } from "@/i18n/utils";

const es = getLangFromUrl(Astro.url) === "es";

// Cada línea es una lista de [clase, texto] para resaltar la sintaxis
const k = "text-[#c792ea]"; // palabras clave
const p = "text-[#82aaff]"; // propiedades
const s = "text-[#c3e88d]"; // strings
const n = "text-[#f78c6c]"; // números / booleanos
const c = "text-muted italic"; // comentarios
const d = "text-fg/70"; // puntuación

const code: [string, string][][] = [
  [[c, es ? "// abner.ts — quién soy, en código" : "// abner.ts — who I am, in code"]],
  [[k, "const "], [p, "abner"], [d, ": "], [p, "Developer"], [d, " = {"]],
  [[p, "  role"], [d, ": "], [s, '"Full Stack Developer"'], [d, ","]],
  [[p, "  location"], [d, ": "], [s, '"Lima, PE"'], [d, ","]],
  [[p, "  stack"], [d, ": ["], [s, '"React"'], [d, ", "], [s, '"Next.js"'], [d, ", "], [s, '"Firebase"'], [d, ", "], [s, '"Kotlin"'], [d, "],"]],
  [[p, "  shipped"], [d, ": "], [n, "13"], [d, ", "], [c, es ? "// proyectos" : "// projects"]],
  [[p, "  inProduction"], [d, ": "], [n, "3"], [d, ","]],
  [[p, "  openToWork"], [d, ": "], [n, "true"], [d, ","]],
  [[d, "  "], [p, "build"], [d, "(idea) {"]],
  [[k, "    return "], [p, "idea"], [d, "."], [p, "design"], [d, "()."], [p, "code"], [d, "()."], [p, "deploy"], [d, "();"]],
  [[d, "  },"]],
  [[d, "};"]],
];

const escape = (text: string) =>
  text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

const html = code.map((line, i) => {
  const number = `<span class="mr-4 inline-block w-5 text-right text-muted/50 select-none">${i + 1}</span>`;
  const tokens = line.map(([cls, text]) => `<span class="${cls}">${escape(text)}</span>`).join("");
  const caret = i === code.length - 1 ? '<span class="caret"></span>' : "";
  return number + tokens + caret;
});
---

<div class="card overflow-hidden font-mono text-[0.72rem] leading-relaxed sm:text-[0.82rem]" data-tilt>
  <div class="relative z-[2] flex items-center gap-2 border-b border-line px-4 py-3">
    <span class="size-3 rounded-full bg-[#ff5f57]"></span>
    <span class="size-3 rounded-full bg-[#febc2e]"></span>
    <span class="size-3 rounded-full bg-[#28c840]"></span>
    <span class="ml-3 rounded-md bg-surface px-2.5 py-1 text-xs text-fg/80">abner.ts</span>
    <span class="ml-auto text-xs text-muted">TypeScript</span>
  </div>
  <div class="relative z-[2] overflow-x-auto p-4 sm:p-5">
    {
      html.map((line, i) => (
        <code class="code-line block whitespace-pre" style={`--i:${i}`} set:html={line} />
      ))
    }
  </div>
  <div class="relative z-[2] flex items-center gap-4 border-t border-line bg-accent-soft px-4 py-1.5 text-[0.65rem] text-muted">
    <span class="text-accent">⎇ main</span>
    <span>✓ 0 errors</span>
    <span class="ml-auto">UTF-8 · LF</span>
  </div>
</div>
