---
import ArrowIcon from "@/components/icons/ArrowIcon.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<a
  href="#projects"
  class="group py-1 sm:py-2 border-2 border-white rounded-3xl w-full
      flex justify-center items-center gap-3
      text-sm 2xl:text-base mt-8 xl:mt-15
      transition-all duration-300 hover:bg-white hover:text-primary hover:font-bold"
  data-aos="fade-up"
  data-aos-duration="1600"
>
  {t("home.cta")}
  <ArrowIcon
    class="size-5 rotate-90 transition-transform duration-300 group-hover:translate-y-0.5"
  />
</a>
