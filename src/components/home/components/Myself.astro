---
import profilePhoto from "@/assets/profile.jpg";
import { Image } from "astro:assets";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div
  class="relative h-auto hover:animate-lift w-64 xs:w-72 md:w-80 xl:w-[65%] 2xl:w-96"
>
  <span
    class="absolute -inset-3 rounded-full bg-gradient-to-br from-accent via-accent/40 to-transparent blur-2xl opacity-60"
    aria-hidden="true"></span>
  <div
    class="relative aspect-square rounded-full p-1.5 bg-gradient-to-br from-accent to-white/70 drop-shadow-[var(--shadow-white)]"
  >
    <Image
      src={profilePhoto}
      alt={t("home.photo-alt")}
      widths={[320, 480, 640]}
      sizes="(min-width: 1280px) 384px, 320px"
      class="size-full rounded-full object-cover object-top bg-primary"
      loading="eager"
      fetchpriority="high"
    />
  </div>
</div>
