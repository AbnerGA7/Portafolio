---
import LangSwitch from "./LangSwitch.astro";
import ThemeSwitch from "./ThemeSwitch.astro";
import Icon from "@/components/ui/Icon.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import { getRoute, getRouteKeyFromPath, navLinks } from "@/lib/routes";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const active = getRouteKeyFromPath(Astro.url.pathname);

// En escritorio "Inicio" lo cubre el logo y "Contacto" va como botón
const desktopLinks = navLinks.filter(
  ({ key }) => key !== "home" && key !== "contact"
);
---

<header data-header class="group/header sticky top-0 z-50 px-3 pt-3 sm:px-4">
  <div
    class="glass mx-auto flex h-16 max-w-6xl items-center justify-between gap-3 rounded-full py-2 pr-2 pl-2 transition-[box-shadow,background] duration-300 sm:pl-3"
    style="background-color: color-mix(in oklab, var(--bg) 62%, transparent)"
  >
    <a
      href={getRoute("home", lang)}
      class="group flex items-center gap-2.5 rounded-full"
      aria-label={t("nav.brand")}
      data-magnetic
    >
      <span
        class="grid size-11 place-items-center rounded-full bg-gradient-to-br from-accent to-accent-2 font-mono text-sm font-bold text-accent-ink shadow-[inset_0_1px_0_rgb(255_255_255/0.45)] transition-transform duration-500 group-hover:rotate-[360deg]"
      >
        AG
      </span>
      <span class="hidden font-display text-[1.05rem] font-semibold whitespace-nowrap sm:block">
        Abner Gonzales
      </span>
    </a>

    <nav class="hidden xl:block" aria-label="Principal">
      <ul class="relative flex items-center" data-nav>
        <span
          data-nav-indicator
          aria-hidden="true"
          class="pointer-events-none absolute top-0 left-0 h-full rounded-full bg-fg/10 opacity-0 shadow-[inset_0_1px_0_rgb(255_255_255/0.18)] transition-[transform,width,opacity] duration-500 ease-[cubic-bezier(0.3,1.4,0.5,1)]"
        ></span>
        {
          desktopLinks.map(({ key, label }) => (
            <li class="relative">
              {active === key && (
                <span
                  aria-hidden="true"
                  class="absolute inset-0 rounded-full bg-accent-soft ring-1 ring-accent/40"
                  style="view-transition-name: nav-pill"
                />
              )}
              <a
                href={getRoute(key, lang)}
                aria-current={active === key ? "page" : undefined}
                class:list={[
                  "relative block rounded-full px-4 py-2 text-sm whitespace-nowrap transition-colors",
                  active === key ? "text-fg" : "text-muted hover:text-fg",
                ]}
              >
                {t(label)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <div class="glass flex h-11 items-center gap-1 rounded-full p-1">
        <LangSwitch />
        <span class="h-5 w-px bg-line" aria-hidden="true"></span>
        <ThemeSwitch />
      </div>
      <a
        href={getRoute("contact", lang)}
        aria-current={active === "contact" ? "page" : undefined}
        class="btn btn-primary hidden md:inline-flex"
      >
        {t("nav.contact")}
        <Icon name="arrow-up-right" class="size-3.5" />
      </a>
      <button
        type="button"
        data-menu-open
        class="glass grid size-11 place-items-center rounded-full xl:hidden"
        aria-label={t("nav.menu.open")}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="menu" class="size-4" />
      </button>
    </div>
  </div>
</header>

<div
  id="mobile-menu"
  data-menu
  data-open="false"
  class="group/menu invisible fixed inset-0 z-[60] flex flex-col bg-bg/70 opacity-0 backdrop-blur-2xl transition-[opacity,visibility] duration-300 data-[open=true]:visible data-[open=true]:opacity-100 xl:hidden"
  role="dialog"
  aria-modal="true"
  aria-label={t("nav.menu")}
>
  <div class="container-page flex h-(--header-h) items-center justify-between">
    <span class="kicker">{t("nav.menu")}</span>
    <button
      type="button"
      data-menu-close
      class="glass grid size-11 place-items-center rounded-full"
      aria-label={t("nav.menu.close")}
    >
      <Icon name="close" class="size-4" />
    </button>
  </div>
  <nav class="container-page flex-1 overflow-y-auto pb-10">
    <ul>
      {
        navLinks.map(({ key, label }, index) => (
          <li
            class="translate-y-6 opacity-0 transition-[opacity,transform] duration-500 ease-out group-data-[open=true]/menu:translate-y-0 group-data-[open=true]/menu:opacity-100"
            style={`transition-delay: ${80 + index * 45}ms`}
          >
            <a
              href={getRoute(key, lang)}
              aria-current={active === key ? "page" : undefined}
              class="group flex items-baseline gap-4 border-b border-line py-4"
            >
              <span class="font-mono text-xs text-muted">
                {String(index + 1).padStart(2, "0")}
              </span>
              <span
                class:list={[
                  "font-display text-3xl font-semibold tracking-tight transition-[color,transform] duration-300 group-hover:translate-x-2",
                  active === key ? "text-accent" : "group-hover:text-accent",
                ]}
              >
                {t(label)}
              </span>
              <Icon
                name="arrow-right"
                class="ml-auto size-5 self-center text-muted transition-transform group-hover:translate-x-1"
              />
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>

<script>
  const setup = () => {
    // Indicador que se desliza bajo el enlace con el cursor
    const nav = document.querySelector<HTMLElement>("[data-nav]");
    const indicator = document.querySelector<HTMLElement>("[data-nav-indicator]");
    if (nav && indicator) {
      const moveTo = (link: HTMLElement | null) => {
        if (!link) {
          indicator.style.opacity = "0";
          return;
        }
        indicator.style.width = `${link.offsetWidth}px`;
        indicator.style.transform = `translateX(${link.offsetLeft}px)`;
        indicator.style.opacity = "1";
      };
      nav.querySelectorAll<HTMLElement>("li").forEach((item) =>
        item.addEventListener("pointerenter", () => moveTo(item))
      );
      nav.addEventListener("pointerleave", () => moveTo(null));
    }

    const menu = document.querySelector<HTMLElement>("[data-menu]");
    const openBtn = document.querySelector<HTMLButtonElement>("[data-menu-open]");
    const closeBtn = document.querySelector<HTMLButtonElement>("[data-menu-close]");
    if (!menu || !openBtn || !closeBtn) return;

    const toggle = (open: boolean) => {
      menu.dataset.open = String(open);
      openBtn.setAttribute("aria-expanded", String(open));
      document.body.style.overflow = open ? "hidden" : "";
      (open ? closeBtn : openBtn).focus();
    };

    openBtn.addEventListener("click", () => toggle(true));
    closeBtn.addEventListener("click", () => toggle(false));
    menu.addEventListener("keydown", (e) => {
      if (e.key === "Escape") toggle(false);
    });
    menu.querySelectorAll("a").forEach((link) =>
      link.addEventListener("click", () => {
        document.body.style.overflow = "";
      })
    );

    document.querySelectorAll("[data-theme-toggle]").forEach((button) =>
      button.addEventListener("click", () => {
        const swap = () => {
          const light = document.documentElement.classList.toggle("light");
          try {
            localStorage.setItem("theme", light ? "light" : "dark");
          } catch {}
        };
        // Cambio de tema con transición suave cuando el navegador lo permite
        if (document.startViewTransition && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
          document.startViewTransition(swap);
        } else {
          swap();
        }
      })
    );
  };

  document.addEventListener("astro:page-load", setup);
</script>
