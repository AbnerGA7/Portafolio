---
import Icon from "@/components/ui/Icon.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const t = useTranslations(getLangFromUrl(Astro.url));
---

<button
  type="button"
  data-theme-toggle
  class="group grid size-9 place-items-center rounded-full text-fg transition-colors duration-300 hover:bg-fg/10"
  aria-label={t("nav.theme")}
  title={t("nav.theme")}
>
  <Icon name="sun" class="size-4 transition-transform duration-700 group-hover:rotate-90 [html.light_&]:hidden" />
  <Icon name="moon" class="hidden size-4 transition-transform duration-500 group-hover:-rotate-12 [html.light_&]:block" />
</button>
