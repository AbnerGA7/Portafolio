---
import Icon from "@/components/ui/Icon.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const t = useTranslations(getLangFromUrl(Astro.url));
---

<button
  type="button"
  data-theme-toggle
  class="grid size-9 place-items-center rounded-full border border-line bg-surface text-fg transition-colors hover:border-fg/30"
  aria-label={t("nav.theme")}
  title={t("nav.theme")}
>
  <Icon name="sun" class="size-4 [html.light_&]:hidden" />
  <Icon name="moon" class="hidden size-4 [html.light_&]:block" />
</button>
