---
import { contactMeData } from "@/data/contactMeData";
import { getLangFromUrl, useText } from "@/i18n/utils";
import { getRoute, navLinks } from "@/lib/routes";

const lang = getLangFromUrl(Astro.url);
const t = useText(lang);
const year = new Date().getFullYear();
const socials = contactMeData.filter(
  ({ title }) => title !== "contact.email.title"
);
---

<footer class="glass mt-24 rounded-t-[2rem] border-b-0">
  <div class="container-page grid gap-10 py-12 md:grid-cols-[1.4fr_1fr_1fr]">
    <div class="max-w-sm">
      <p class="font-display text-2xl font-semibold">Abner Gonzales</p>
      <p class="mt-3 text-sm leading-relaxed text-muted">
        {t("footer.description")}
      </p>
      <a
        href="mailto:abner.gonzales.work@gmail.com"
        class="link-underline mt-5 inline-block font-mono text-sm"
      >
        abner.gonzales.work@gmail.com
      </a>
    </div>

    <nav aria-label="Footer">
      <p class="kicker mb-4">{t("nav.menu")}</p>
      <ul class="grid grid-cols-2 gap-x-4 gap-y-2 text-sm md:grid-cols-1">
        {
          navLinks.map(({ key, label }) => (
            <li>
              <a
                href={getRoute(key, lang)}
                class="text-muted transition-colors hover:text-fg"
              >
                {t(label)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <p class="kicker mb-4">{t("contact.channels.title")}</p>
      <ul class="flex flex-wrap gap-2">
        {
          socials.map(({ title, url, Icon }) => (
            <li>
              <a
                href={t(url)}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={t(title)}
                title={t(title)}
                class="glass grid size-11 place-items-center rounded-full transition-[color,transform] duration-300 hover:-translate-y-1 hover:text-accent"
              >
                <Icon class="size-4 fill-current" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <div class="border-t border-line">
    <div
      class="container-page flex flex-col gap-2 py-5 font-mono text-xs text-muted sm:flex-row sm:justify-between"
    >
      <p>© {year} {t("footer.copyright")}</p>
      <p>Lima, PE · Astro + Tailwind</p>
    </div>
  </div>
</footer>
