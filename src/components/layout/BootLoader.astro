---
import { getLangFromUrl } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const lines =
  lang === "es"
    ? [
        ["$", "ssh visitante@abnergonzales.dev"],
        ["›", "conexión establecida · Lima, PE"],
        ["$", "npm run portafolio"],
        ["✓", "cargando proyectos (13)"],
        ["✓", "compilando experiencia y stack"],
        ["✓", "aplicando liquid glass"],
        ["›", "listo. bienvenido 👋"],
      ]
    : [
        ["$", "ssh visitor@abnergonzales.dev"],
        ["›", "connection established · Lima, PE"],
        ["$", "npm run portfolio"],
        ["✓", "loading projects (13)"],
        ["✓", "compiling experience and stack"],
        ["✓", "applying liquid glass"],
        ["›", "ready. welcome 👋"],
      ];
---

<div
  id="boot"
  transition:persist="boot"
  class="fixed inset-0 z-[100] hidden place-items-center bg-bg/80 px-4 backdrop-blur-xl transition-[opacity,filter] duration-700"
  aria-hidden="true"
>
  <div class="glass w-full max-w-xl overflow-hidden rounded-2xl font-mono text-[0.8rem] sm:text-sm">
    <div class="flex items-center gap-2 border-b border-line px-4 py-3">
      <span class="size-3 rounded-full bg-[#ff5f57]"></span>
      <span class="size-3 rounded-full bg-[#febc2e]"></span>
      <span class="size-3 rounded-full bg-[#28c840]"></span>
      <span class="ml-3 text-xs text-muted">abner@portfolio: ~</span>
      <button type="button" data-boot-skip class="ml-auto text-xs text-muted hover:text-fg">
        skip ⏎
      </button>
    </div>
    <div class="min-h-64 space-y-1.5 p-5" data-boot-out></div>
    <div class="h-1 bg-line">
      <div data-boot-bar class="h-full w-0 bg-gradient-to-r from-accent to-accent-2 transition-[width] duration-300"></div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ lines }}>
  (() => {
    const boot = document.getElementById("boot");
    let seen = false;
    try {
      // Tras redirigir desde el loader, empezar arriba de todo
      if (sessionStorage.getItem("boot-top") === "1") {
        sessionStorage.removeItem("boot-top");
        history.scrollRestoration = "manual";
        scrollTo(0, 0);
        addEventListener("load", () => scrollTo(0, 0), { once: true });
      }
      seen = sessionStorage.getItem("booted") === "1";
      sessionStorage.setItem("booted", "1");
    } catch {}
    if (!boot || seen || matchMedia("(prefers-reduced-motion: reduce)").matches) {
      boot?.remove();
      return;
    }
    boot.classList.replace("hidden", "grid");
    document.documentElement.style.overflow = "hidden";

    const out = boot.querySelector("[data-boot-out]");
    const bar = boot.querySelector("[data-boot-bar]");
    const colors = { "$": "text-accent", "✓": "text-emerald-400", "›": "text-accent-2" };
    let done = false;

    const finish = () => {
      if (done) return;
      done = true;
      boot.style.opacity = "0";
      boot.style.filter = "blur(8px)";
      document.documentElement.style.overflow = "";
      // Siempre aterriza en el inicio, arriba, donde está la presentación
      const home = location.pathname.startsWith("/en") ? "/en/" : "/";
      if (location.pathname !== home) {
        try {
          sessionStorage.setItem("boot-top", "1");
        } catch {}
        location.replace(home);
        return;
      }
      scrollTo(0, 0);
      setTimeout(() => boot.remove(), 700);
    };
    boot.querySelector("[data-boot-skip]").addEventListener("click", finish);
    addEventListener("keydown", finish, { once: true });

    const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
    (async () => {
      for (let i = 0; i < lines.length && !done; i++) {
        const [sym, text] = lines[i];
        const row = document.createElement("p");
        row.innerHTML = `<span class="${colors[sym]}">${sym}</span> <span></span>`;
        out.appendChild(row);
        const target = row.lastElementChild;
        if (sym === "$") {
          for (const ch of text) {
            if (done) return;
            target.textContent += ch;
            await sleep(28);
          }
        } else {
          target.textContent = text;
          target.className = "text-muted";
        }
        bar.style.width = `${((i + 1) / lines.length) * 100}%`;
        await sleep(sym === "$" ? 220 : 260);
      }
      const cursor = document.createElement("span");
      cursor.className = "inline-block h-4 w-2 translate-y-0.5 animate-pulse bg-accent";
      out.appendChild(cursor);
      await sleep(600);
      finish();
    })();
  })();
</script>
