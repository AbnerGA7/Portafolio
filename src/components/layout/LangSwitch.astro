---
import { languages } from "@/i18n/ui";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import { getAlternatePath } from "@/lib/routes";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div
  class="flex h-9 items-center rounded-full font-mono text-[0.7rem]"
  role="group"
  aria-label={t("nav.lang")}
>
  {
    languages.map(({ code, title }) => (
      <a
        href={getAlternatePath(Astro.url.pathname, code)}
        hreflang={code}
        lang={code}
        title={title}
        aria-current={code === lang ? "true" : undefined}
        class:list={[
          "grid h-full place-items-center rounded-full px-3 uppercase transition-all duration-300",
          code === lang
            ? "bg-gradient-to-br from-accent to-accent-2 text-accent-ink shadow-[inset_0_1px_0_rgb(255_255_255/0.4)]"
            : "text-muted hover:text-fg",
        ]}
      >
        {code}
      </a>
    ))
  }
</div>
