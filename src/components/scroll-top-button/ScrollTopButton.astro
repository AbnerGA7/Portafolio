---
import ArrowIcon from "@/components/icons/ArrowIcon.astro";
import { navItemsData } from "@/data/navItemsData";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<a
  id="scrollTopButton"
  href={navItemsData[0].link}
  class="fixed bottom-5 right-5 text-primary bg-white p-1 sm:p-2 md:p-3 rounded-full shadow-lg opacity-0 pointer-events-none
        transition-all duration-300 animate-float hover:scale-115 hover:bg-accent"
  aria-label={t("scroll-top")}
  title={t("scroll-top")}
>
  <ArrowIcon class="size-10 rotate-270" />
</a>
