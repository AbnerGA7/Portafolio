---
import CalendarIcon from "@/components/icons/CalendarIcon.astro";
import CertificateIcon from "@/components/icons/CertificateIcon.astro";
import type { Experience } from "@/types/Experience";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

interface Props {
  item: Experience;
}

const { item } = Astro.props;
const { title, company, description, date, Icon, stack, documentUrl } = item;
---

<div
  class="relative grid lg:grid-cols-5 gap-8 xl:gap-2 pb-15 xl:pb-24
        before:absolute before:left-[-20px] sm:before:left-[-35px] before:block before:h-full before:border-l-2 before:border-gray-600 before:content-['']"
  data-aos="fade-up"
  data-aos-duration="800"
>
  <div class="lg:col-span-2">
    <div class="sticky top-0">
      <span
        class="text-accent -left-[28px] sm:-left-[42px] absolute rounded-full text-5xl"
        aria-hidden="true">&bull;</span
      >
      <h3 class="text-2xl font-bold text-white mb-2">{t(title)}</h3>
      <div class="flex justify-start gap-4">
        <div
          class="flex size-15 xs:size-20 shrink-0 items-center justify-center rounded-2xl border border-accent/30 bg-accent/10 text-accent"
        >
          <Icon class="size-8 xs:size-10" />
        </div>
        <div class="flex flex-col justify-center">
          <h4 class="text-white text-base sm:text-lg xl:text-xl">
            {t(company)}
          </h4>
          <p class="text-gray-300 flex gap-1 items-center text-xs xl:text-sm">
            <CalendarIcon class="size-5 text-accent" />
            {t(date)}
          </p>
          {
            documentUrl && (
              <a
                href={documentUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-1 inline-flex w-fit items-center gap-1 text-xs xl:text-sm font-medium text-accent hover:underline"
              >
                <CertificateIcon class="size-4" />
                {t("experience.button.certificate")}
              </a>
            )
          }
        </div>
      </div>
    </div>
  </div>
  <div
    class="h-full flex flex-col justify-center max-w-[95%] sm:max-w-3xl lg:max-w-full lg:col-span-3 gap-4 text-sm md:text-base"
  >
    <p
      class="text-white font-normal text-justify text-pretty"
      set:html={t(description)}
    />
    <ul class="flex flex-wrap gap-2 mt-2">
      {
        stack.map(({ Icon, title }) => (
          <li class="flex items-center gap-2 px-3 py-1 rounded-full text-xs xl:text-sm text-white font-medium bg-white/10 hover:bg-white/20 border-white/10 hover:animate-lift-soft no-select">
            <Icon class="size-4 xs:size-5" /> {title}
          </li>
        ))
      }
    </ul>
  </div>
</div>
