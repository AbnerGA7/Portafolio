---
import { techSkillsData } from "@/components/skills/data/techSkillsData";
import NextPage from "@/components/ui/NextPage.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import type { TranslationKey } from "@/i18n/types";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import Layout from "@/layouts/Layout.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const groups = Object.entries(techSkillsData) as [
  TranslationKey,
  NonNullable<(typeof techSkillsData)[TranslationKey]>,
][];
---

<Layout title={t("skills.title")}>
  <PageHeader
    page="skills"
    title={t("skills.title")}
    description={t("skills.description")}
  />

  <section class="container-page">
    <div class="grid gap-5 md:grid-cols-2">
      {
        groups.map(([category, items], i) => (
          <article
            class="reveal card p-5 sm:p-7"
            style={`--i:${i + 2}`}
          >
            <header class="flex items-baseline justify-between gap-4">
              <h2 class="text-2xl font-semibold">{t(category)}</h2>
              <span class="font-mono text-xs text-muted">
                {String(items.length).padStart(2, "0")} {t("skills.count")}
              </span>
            </header>
            <ul class="mt-6 grid grid-cols-2 gap-2 xs:grid-cols-3">
              {items.map(({ Icon, name, tooltip }) => (
                <li
                  class="group flex items-center gap-2.5 rounded-2xl border border-line bg-surface px-3 py-2.5 transition-all duration-300 hover:-translate-y-1 hover:border-(--brand) hover:shadow-[0_10px_30px_-12px_var(--brand)]"
                  style={`--brand:${tooltip.color}`}
                >
                  <Icon className="size-6 shrink-0 transition-transform duration-500 group-hover:scale-125 group-hover:rotate-[-8deg]" />
                  <span class="truncate text-sm">{name}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <NextPage page="skills" />
</Layout>
