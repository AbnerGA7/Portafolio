---
import ContactForm from "@/components/contact/ContactForm";
import Icon from "@/components/ui/Icon.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import { contactMeData } from "@/data/contactMeData";
import { getContactFormTranslations, getLangFromUrl, useText } from "@/i18n/utils";
import Layout from "@/layouts/Layout.astro";

const lang = getLangFromUrl(Astro.url);
const t = useText(lang);
const formTranslations = getContactFormTranslations(lang);
---

<Layout title={t("nav.contact")}>
  <PageHeader
    page="contact"
    title={t("contact.title")}
    description={t("contact.subtitle")}
  />

  <section class="container-page grid gap-8 lg:grid-cols-[1fr_1.2fr] lg:gap-12">
    <div class="reveal" style="--i:2">
      <button
        type="button"
        data-copy="abner.gonzales.work@gmail.com"
        class="card group mb-6 flex w-full items-center gap-4 p-4 text-left"
      >
        <span class="relative z-[2] grid size-12 shrink-0 place-items-center rounded-2xl bg-gradient-to-br from-accent to-accent-2 text-accent-ink">@</span>
        <span class="relative z-[2] min-w-0 flex-1">
          <span class="block truncate font-mono text-sm">abner.gonzales.work@gmail.com</span>
          <span data-copy-label class="block text-xs text-muted">{lang === "es" ? "Toca para copiar el email" : "Tap to copy the email"}</span>
        </span>
        <span class="relative z-[2] chip">{lang === "es" ? "copiar" : "copy"}</span>
      </button>
      <p class="kicker">{t("contact.channels.title")}</p>
      <ul class="mt-4 divide-y divide-line border-y border-line">
        {
          contactMeData.map(({ title, description, url, Icon: ChannelIcon }) => (
            <li>
              <a
                href={t(url)}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-center gap-4 rounded-2xl px-2 py-4 transition-all duration-300 hover:translate-x-1 hover:bg-surface"
              >
                <span class="glass grid size-12 shrink-0 place-items-center rounded-2xl transition-all duration-300 group-hover:scale-110 group-hover:-rotate-6 group-hover:text-accent">
                  <ChannelIcon class="size-5 fill-current" />
                </span>
                <span class="min-w-0 flex-1">
                  <span class="block font-medium">{t(title)}</span>
                  <span class="block truncate text-sm text-muted">
                    {t(description)}
                  </span>
                </span>
                <Icon
                  name="arrow-up-right"
                  class="size-4 shrink-0 text-muted transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-accent"
                />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="reveal card p-5 sm:p-8" style="--i:3">
      <h2 class="text-2xl font-semibold">{t("contact.form.title")}</h2>
      <div class="mt-6">
        <ContactForm translations={formTranslations} client:visible />
      </div>
    </div>
  </section>
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const button = document.querySelector<HTMLElement>("[data-copy]");
    const label = button?.querySelector("[data-copy-label]");
    if (!button || !label) return;
    const original = label.textContent;
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy!);
        label.textContent = document.documentElement.lang === "es" ? "✓ ¡Copiado! Pégalo en tu correo" : "✓ Copied! Paste it in your email";
        label.classList.add("text-emerald-400");
      } catch {
        location.href = `mailto:${button.dataset.copy}`;
      }
      setTimeout(() => {
        label.textContent = original;
        label.classList.remove("text-emerald-400");
      }, 2200);
    });
  });
</script>
