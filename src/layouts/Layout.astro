---
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";
import SiteFooter from "@/components/layout/SiteFooter.astro";
import SiteHeader from "@/components/layout/SiteHeader.astro";
import BootLoader from "@/components/layout/BootLoader.astro";
import Terminal from "@/components/layout/Terminal.astro";
import { languages } from "@/i18n/ui";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import { getAlternatePath } from "@/lib/routes";

interface Props {
  /** Título de la página; se completa con "| Abner Gonzales" */
  title?: string;
  description?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { title, description = t("meta.description") } = Astro.props;
const pageTitle = title ? `${title} | Abner Gonzales` : t("meta.title");

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const alternateUrl = (code: (typeof languages)[number]["code"]) =>
  new URL(getAlternatePath(Astro.url.pathname, code), Astro.site).href;
const ogImage = new URL("/og-image.png", Astro.site).href;
const ogLocale = lang === "es" ? "es_PE" : "en_US";

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Abner Gonzales",
  jobTitle: "Full Stack Developer",
  url: new URL("/", Astro.site).href,
  image: ogImage,
  email: "mailto:abner.gonzales.work@gmail.com",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Lima",
    addressCountry: "PE",
  },
  knowsAbout: [
    "React",
    "React Native",
    "Next.js",
    "Firebase",
    "Android",
    "Kotlin",
    "JavaScript",
    "Tailwind CSS",
  ],
  sameAs: [
    "https://github.com/AbnerGA7",
    "https://www.linkedin.com/in/abnergonzales7/",
    "https://www.instagram.com/abner_gonzales7",
    "https://www.facebook.com/abnerGonzalesA.7",
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Abner Gonzales" />
    <meta name="theme-color" content="#050507" />

    <link rel="canonical" href={canonicalUrl} />
    {
      languages.map(({ code }) => (
        <link rel="alternate" hreflang={code} href={alternateUrl(code)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={alternateUrl("es")} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:site_name" content={t("meta.og.site_name")} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={title ? pageTitle : t("meta.og.title")} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />

    <script is:inline>
      // Aplica el tema antes de pintar y después de cada navegación
      const applyTheme = () => {
        let theme = null;
        try {
          theme = localStorage.getItem("theme");
        } catch {}
        if (theme !== "light" && theme !== "dark") {
          theme = matchMedia("(prefers-color-scheme: light)").matches
            ? "light"
            : "dark";
        }
        document.documentElement.classList.toggle("light", theme === "light");
        document.documentElement.classList.add("js");
      };
      applyTheme();
      document.addEventListener("astro:after-swap", applyTheme);
    </script>

    <ClientRouter />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <BootLoader />
    <div class="aurora" aria-hidden="true" transition:persist="aurora">
      <span class="grid"></span>
      <canvas data-code-bg class="absolute inset-0 size-full"></canvas>
      <span class="blob b1"></span>
      <span class="blob b2"></span>
      <span class="blob b3"></span>
      <span class="glow"></span>
    </div>
    <div
      class="fixed inset-x-0 top-0 z-[70] h-0.5 origin-left bg-gradient-to-r from-accent to-accent-2"
      style="transform: scaleX(var(--scroll, 0))"
      aria-hidden="true"
      transition:persist="progress"
    >
    </div>
    <a
      href="#main"
      class="sr-only z-[70] rounded-full bg-accent px-4 py-2 text-accent-ink focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      {t("nav.skip")}
    </a>
    <SiteHeader />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <SiteFooter />
    <Terminal />

    <button
      type="button"
      data-to-top
      class="glass fixed right-4 bottom-4 z-40 grid size-12 translate-y-4 place-items-center rounded-full opacity-0 transition-[opacity,transform] duration-300 data-[show=true]:translate-y-0 data-[show=true]:opacity-100 sm:right-6 sm:bottom-6"
      aria-label={t("scroll-top")}
      title={t("scroll-top")}
      tabindex="-1"
    >
      <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 19V5M6 11l6-6 6 6"></path>
      </svg>
    </button>
  </body>
</html>

<script>
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const finePointer = matchMedia("(pointer: fine)").matches;
  const root = document.documentElement;

  // --- Listeners globales: se registran una sola vez ---

  // Barra de progreso y botón "volver arriba"
  const onScroll = () => {
    const max = root.scrollHeight - innerHeight;
    root.style.setProperty("--scroll", String(max > 0 ? scrollY / max : 0));
    const toTop = document.querySelector<HTMLElement>("[data-to-top]");
    if (toTop) {
      const show = scrollY > 600;
      toTop.dataset.show = String(show);
      toTop.tabIndex = show ? 0 : -1;
    }
    document
      .querySelector("[data-header]")
      ?.toggleAttribute("data-scrolled", scrollY > 12);
  };
  addEventListener("scroll", onScroll, { passive: true });

  document.addEventListener("click", (e) => {
    if ((e.target as Element).closest("[data-to-top]")) {
      scrollTo({ top: 0, behavior: reduced ? "auto" : "smooth" });
    }
  });

  let frame = 0;
  document.addEventListener(
    "pointermove",
    (e) => {
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        // Luz del fondo
        root.style.setProperty("--cx", `${e.clientX}px`);
        root.style.setProperty("--cy", `${e.clientY}px`);

        const target = e.target as Element;
        // Reflejo sobre las tarjetas de vidrio
        const card = target.closest?.<HTMLElement>(".card");
        if (card) {
          const r = card.getBoundingClientRect();
          card.style.setProperty("--mx", `${e.clientX - r.left}px`);
          card.style.setProperty("--my", `${e.clientY - r.top}px`);
        }
        if (reduced || !finePointer) return;

        // Inclinación 3D
        const tilt = target.closest?.<HTMLElement>("[data-tilt]");
        if (tilt) {
          const r = tilt.getBoundingClientRect();
          const x = (e.clientX - r.left) / r.width - 0.5;
          const y = (e.clientY - r.top) / r.height - 0.5;
          tilt.style.transform = `perspective(900px) rotateX(${-y * 7}deg) rotateY(${x * 9}deg) translateY(-4px)`;
        }

        // Botones magnéticos
        const magnet = target.closest?.<HTMLElement>(".btn, [data-magnetic]");
        if (magnet) {
          const r = magnet.getBoundingClientRect();
          const x = e.clientX - (r.left + r.width / 2);
          const y = e.clientY - (r.top + r.height / 2);
          magnet.style.transform = `translate(${x * 0.18}px, ${y * 0.25}px)`;
        }
      });
    },
    { passive: true }
  );

  document.addEventListener(
    "pointerout",
    (e) => {
      const target = e.target as Element;
      const related = e.relatedTarget as Node | null;
      for (const el of [
        target.closest?.<HTMLElement>("[data-tilt]"),
        target.closest?.<HTMLElement>(".btn, [data-magnetic]"),
      ]) {
        if (el && !el.contains(related)) el.style.transform = "";
      }
    },
    { passive: true }
  );

  // Fondo de código: fragmentos que flotan y se encienden cerca del cursor
  const canvas = document.querySelector<HTMLCanvasElement>("[data-code-bg]");
  const ctx = canvas?.getContext("2d");
  if (canvas && ctx && !reduced) {
    const tokens = [
      "const", "=>", "{ }", "</>", "async", "await", "npm run dev", "git push",
      "return", "import", "useState()", "SELECT *", "fun main()", "[]", "&&",
      "200 OK", "deploy()", "true", "null", "λ", "0x1F", "01101", "#!/bin", "export",
    ];
    let w = 0;
    let h = 0;
    let mx = -9999;
    let my = -9999;
    type Glyph = { x: number; y: number; v: number; t: string; s: number; a: number };
    let glyphs: Glyph[] = [];

    const spawn = (y?: number): Glyph => ({
      x: Math.random() * w,
      y: y ?? h + 20,
      v: 0.15 + Math.random() * 0.35,
      t: tokens[(Math.random() * tokens.length) | 0],
      s: 11 + Math.random() * 6,
      a: 0.07 + Math.random() * 0.12,
    });

    const resize = () => {
      const dpr = Math.min(devicePixelRatio, 2);
      w = innerWidth;
      h = innerHeight;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const count = Math.round((w * h) / 26000);
      glyphs = Array.from({ length: count }, () => spawn(Math.random() * h));
    };
    resize();
    addEventListener("resize", resize);
    addEventListener("pointermove", (e) => {
      mx = e.clientX;
      my = e.clientY;
    }, { passive: true });

    const draw = () => {
      ctx.clearRect(0, 0, w, h);
      const light = root.classList.contains("light");
      for (const g of glyphs) {
        g.y -= g.v;
        if (g.y < -20) Object.assign(g, spawn());
        const dist = Math.hypot(g.x - mx, g.y - my);
        const near = Math.max(0, 1 - dist / 180);
        ctx.font = `${g.s}px "JetBrains Mono Variable", monospace`;
        ctx.fillStyle = near > 0
          ? `rgba(167, 139, 250, ${g.a + near * 0.7})`
          : light
            ? `rgba(26, 34, 50, ${g.a})`
            : `rgba(255, 255, 255, ${g.a})`;
        ctx.fillText(g.t, g.x + (g.x - mx) * near * 0.08, g.y + (g.y - my) * near * 0.08);
      }
      requestAnimationFrame(draw);
    };
    requestAnimationFrame(draw);
  }

  // --- Por página: se vuelve a ejecutar tras cada navegación ---
  const countUp = (el: HTMLElement) => {
    const target = Number(el.dataset.count);
    if (reduced || !target) return;
    const start = performance.now();
    const from = target > 1000 ? target - 30 : 0;
    const step = (now: number) => {
      const p = Math.min((now - start) / 1400, 1);
      const eased = 1 - Math.pow(1 - p, 4);
      el.textContent = String(Math.round(from + (target - from) * eased));
      if (p < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };

  document.addEventListener("astro:page-load", () => {
    onScroll();
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const el = entry.target as HTMLElement;
          el.classList.add("is-in");
          if (el.dataset.count) countUp(el);
          observer.unobserve(el);
        }
      },
      { rootMargin: "0px 0px -8% 0px", threshold: 0.12 }
    );
    document
      .querySelectorAll(".reveal, [data-count]")
      .forEach((el) => observer.observe(el));
  });
</script>
